---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CrtTerminal from '../components/CrtTerminal.tsx';
import TaglineReveal from '../components/TaglineReveal.tsx';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const featuredProject = sortedProjects.find((p) => p.data.featured) || sortedProjects[0];
const standardProjects = sortedProjects.filter((p) => p.id !== featuredProject.id);

const teamMembers = [
  {
    name: 'Nikhil Malisetty',
    role: 'Systems & Frontend Architect',
    image: '/team/nikhil.jpg',
    bio: 'Engineer focused on resilient web applications, tactile UI ergonomics, and autonomous agent-driven development workflows.',
    github: 'https://github.com/nikhilmalisetty',
  },
  {
    name: 'Prem Swaroop',
    role: 'Spatial Systems & Product Engineer',
    image: '/team/prem.jpg',
    bio: 'Engineer specializing in geospatial geometry, regulatory compliance pipelines, and high-integrity cloud architectures.',
    github: 'https://github.com/akpremswaroop',
  },
  {
    name: 'Sree Teja Gunda',
    role: 'Fullstack & Mobile Engineer',
    image: '/team/sreeteja.jpg',
    bio: 'Product engineer passionate about reactive interface patterns, cross-platform mobile apps, and developer productivity tooling.',
    github: 'https://github.com/gundasreeteja',
  },
];

const capabilities = [
  {
    category: 'Spatial & GIS',
    description: 'Cadastral mapping, Lake FTL buffers, stormwater stream analysis, and geospatial compliance engines.',
    tags: ['Leaflet GIS', 'Turf.js', 'GeoJSON', 'Mappls API', 'HMDA Data'],
  },
  {
    category: 'Modern Web Architecture',
    description: 'High-performance reactive user interfaces and server-rendered single-deployment architectures.',
    tags: ['React 19', 'Astro', 'TypeScript', 'Tailwind CSS', 'Vite'],
  },
  {
    category: 'Resilient Cloud & Storage',
    description: 'Client-side zero-knowledge encryption, transactional databases, and server-side cache-aside models.',
    tags: ['Oracle ADB', 'MongoDB Atlas', 'Better Auth', 'Cloudflare Turnstile'],
  },
  {
    category: 'Autonomous Workflows',
    description: 'Agent-augmented development loops, issue tracking via Model Context Protocol, and automated test harnesses.',
    tags: ['Linear MCP', 'Agentic Workflows', 'Vitest', 'CDP Automation'],
  },
];
---

<Layout title="SnapLabs — Independent Engineering | Purpose Built Software">
  <!-- Hero Section -->
  <section class="relative pt-16 sm:pt-24 pb-20 px-6 overflow-hidden">
    <!-- Ambient subtle background glow -->
    <div class="pointer-events-none absolute -top-40 -left-40 w-[600px] h-[600px] bg-[#e11d48]/5 rounded-full blur-[140px] -z-10"></div>

    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Editorial Display Typography -->
      <div class="lg:col-span-7">
        <div class="tag-line mb-8">
          Independent Engineering Trio
        </div>

        <h1 class="font-serif tracking-tight text-white mb-8 max-w-[680px]">
          <span class="block text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal tracking-tight text-white leading-[1.12] sm:leading-[1.08] break-words">
            Purpose Built Software for Real World Problems
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 max-w-xl leading-relaxed mb-10 font-normal">
          We are three friends and developers who talk tech and AI, spot broken workflows in daily life, and engineer tools to solve them. Each project was built because we ran into the problem ourselves.
        </p>

        <!-- Single high-contrast primary CTA per landing-page-design -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="#projects"
            class="px-6 py-3.5 rounded-xl bg-[#e11d48] hover:bg-[#be123c] text-white text-xs font-semibold uppercase tracking-widest transition-all active:scale-95 shadow-lg shadow-[#e11d48]/25 text-center min-h-[44px] flex items-center justify-center"
          >
            Explore Projects
          </a>
          <a
            href="#team"
            class="px-4 py-3 text-xs font-mono text-zinc-400 hover:text-white transition-colors text-center min-h-[44px] flex items-center justify-center"
          >
            Meet the trio ↓
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive WebGL Phosphor CRT Telemetry Terminal -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <CrtTerminal client:only="react" initialMode="green" />
      </div>
    </div>
  </section>

  <!-- Metrics / Proof Row -->
  <section class="max-w-6xl mx-auto px-6 mb-16">
    <div class="editorial-card rounded-2xl p-8 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/[0.08]">
      <div class="py-4 md:py-0 md:px-6 text-center">
        <div class="font-serif text-4xl sm:text-5xl font-light text-white tracking-tight">3</div>
        <div class="text-xs uppercase tracking-widest text-zinc-400 font-medium mt-2">Purpose Built Systems</div>
      </div>

      <div class="py-4 md:py-0 md:px-6 text-center">
        <div class="font-serif text-4xl sm:text-5xl font-light text-[#e11d48] tracking-tight">100%</div>
        <div class="text-xs uppercase tracking-widest text-zinc-400 font-medium mt-2">Real Problem Grounding</div>
      </div>

      <div class="py-4 md:py-0 md:px-6 text-center">
        <div class="font-serif text-4xl sm:text-5xl font-light text-zinc-200 tracking-tight">0</div>
        <div class="text-xs uppercase tracking-widest text-zinc-400 font-medium mt-2">Corporate Middlemen</div>
      </div>
    </div>
  </section>

  <!-- Mandatory Tagline Reveal Section (B11) -->
  <TaglineReveal client:visible />

  <!-- Projects Section -->
  <section id="projects" class="max-w-6xl mx-auto px-6 mb-32 scroll-mt-24">
    <div class="flex items-end justify-between mb-12 border-b border-white/[0.06] pb-6">
      <div>
        <div class="tag-line mb-3">Shipped Systems</div>
        <h2 class="font-serif text-3xl sm:text-5xl font-normal text-white tracking-tight">
          Projects
        </h2>
        <p class="text-sm text-zinc-400 mt-2">
          Each system addresses a tangible personal or societal challenge we experienced firsthand.
        </p>
      </div>

      <div class="text-xs font-mono text-zinc-500">
        Showing all {allProjects.length} systems
      </div>
    </div>

    <!-- Featured Showcase Project (Split View) -->
    <div class="mb-8">
      <ProjectCard project={featuredProject} featured={true} />
    </div>

    <!-- Standard Projects (2-Column Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {standardProjects.map((project) => (
        <ProjectCard project={project} featured={false} />
      ))}
    </div>
  </section>

  <!-- Technical Foundation Bento Grid -->
  <section id="architecture" class="max-w-6xl mx-auto px-6 mb-32 scroll-mt-24">
    <div class="mb-12 border-b border-white/[0.06] pb-6">
      <div class="tag-line mb-3">Capabilities</div>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-white tracking-tight">
        Technical Foundation
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {capabilities.map((cap) => (
        <div class="editorial-card rounded-2xl p-6 flex flex-col justify-between group">
          <div>
            <div class="text-xs font-mono tracking-wider text-[#e11d48] uppercase mb-2">
              Domain
            </div>
            <h3 class="font-serif text-xl font-normal text-white mb-3 group-hover:text-zinc-200 transition-colors">
              {cap.category}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed mb-6">
              {cap.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/[0.06]">
            {cap.tags.map((tag) => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] text-zinc-400 border border-white/[0.05]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- The Trio: Three Friends & Developers -->
  <section id="team" class="max-w-6xl mx-auto px-6 mb-32 scroll-mt-24">
    <div class="mb-12 border-b border-white/[0.06] pb-6">
      <div class="tag-line mb-3">The Builders</div>
      <h2 class="font-serif text-3xl sm:text-5xl font-normal text-white tracking-tight">
        Three Friends in Real Life
      </h2>
      <p class="text-sm text-zinc-400 max-w-xl mt-3 font-normal">
        We talk constantly about tech, emerging AI capabilities, and software craft. When we spot broken workflows, we build software together to solve them.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {teamMembers.map((member) => (
        <article class="editorial-card rounded-2xl p-7 flex flex-col justify-between group relative overflow-hidden">
          <div>
            <!-- Member Avatar Frame with Subtle Glow -->
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl overflow-hidden bg-black/50 border border-white/15 p-1 flex-shrink-0 group-hover:border-white/30 transition-colors shadow-inner">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>

              <div>
                <h3 class="font-serif text-2xl font-normal text-white mb-1 group-hover:text-zinc-200 transition-colors">
                  {member.name}
                </h3>
                <div class="text-[11px] font-mono tracking-wider text-[#e11d48] uppercase">
                  {member.role}
                </div>
              </div>
            </div>

            <p class="text-xs text-zinc-400 leading-relaxed font-normal">
              {member.bio}
            </p>
          </div>

          <div class="pt-6 border-t border-white/[0.06] mt-6 flex justify-between items-center text-xs">
            <span class="text-zinc-500 font-mono text-[11px]">Core Engineer</span>
            <a
              href={member.github}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-zinc-400 hover:text-white transition-colors"
            >
              github ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Bottom Contact Banner (Per user instruction: Contact stays at the end) -->
  <section class="max-w-6xl mx-auto px-6 mb-24">
    <div class="editorial-card rounded-3xl p-8 sm:p-14 relative overflow-hidden text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-8">
      <div class="max-w-xl">
        <div class="tag-line mb-3">Conversation</div>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white tracking-tight mb-3">
          Have a real world problem?
        </h2>
        <p class="text-sm text-zinc-400 leading-relaxed font-normal">
          We collaborate with fellow developers, discuss emerging AI patterns, and build software that respects what a user needs.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="mailto:contact@snaplabs.tech"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#e11d48] hover:bg-[#be123c] text-white text-xs font-semibold uppercase tracking-widest transition-all active:scale-95 shadow-lg shadow-[#e11d48]/25 text-center"
        >
          Start a Conversation
        </a>
        <a
          href="https://github.com/MugguruMonagallu"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-white/10 hover:border-white/25 text-zinc-300 hover:text-white text-xs font-semibold uppercase tracking-widest transition-all active:scale-95 hover:bg-white/[0.03] text-center"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
