---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget';
import HeaderNav from '../components/HeaderNav';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'SnapLabs — Independent Engineering | Purpose Built Software',
  description = 'SnapLabs is an independent engineering trio building purpose-built software: spatial GIS compliance tools, zero-knowledge encrypted vaults, and agentic workflows.',
  image = '/logo.png',
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ? Astro.site.toString() : 'https://snaplabs.tech';
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const socialImageURL = new URL(image, siteURL).href;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.TURNSTILE_SITE_KEY ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://snaplabs.tech/#website',
      url: 'https://snaplabs.tech',
      name: 'SnapLabs',
      description,
      publisher: {
        '@id': 'https://snaplabs.tech/#organization',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://snaplabs.tech/#organization',
      name: 'SnapLabs',
      url: 'https://snaplabs.tech',
      logo: new URL('/logo.png', siteURL).href,
      email: 'contact@snaplabs.tech',
      sameAs: ['https://github.com/MugguruMonagallu'],
      founder: [
        {
          '@type': 'Person',
          name: 'Nikhil Malisetty',
          jobTitle: 'Systems & Full-Stack Architect',
          sameAs: [
            'https://github.com/nikhilmalisetty',
            'https://www.linkedin.com/in/nikhilmalisetty/',
          ],
        },
        {
          '@type': 'Person',
          name: 'Prem Swaroop',
          jobTitle: 'Quality & Systems Engineer',
          sameAs: [
            'https://github.com/akpremswaroop',
            'https://www.linkedin.com/in/akpremswaroop/',
          ],
        },
        {
          '@type': 'Person',
          name: 'Sree Teja Gunda',
          jobTitle: 'Senior Backend & Cloud Engineer',
          sameAs: [
            'https://github.com/gundasreeteja',
            'https://www.linkedin.com/in/sreetejagunda/',
          ],
        },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://snaplabs.tech/#rera-sentinel',
      name: 'RERA Sentinel',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: 'Automated cadastral compliance and geospatial buffer verification engine for real estate plots in Telangana.',
      url: 'https://github.com/MugguruMonagallu/rera-admin',
      creator: {
        '@id': 'https://snaplabs.tech/#organization',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://snaplabs.tech/#family-vault',
      name: 'Family Vault',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Web',
      description: 'Client-side zero-knowledge encrypted vault for sensitive family documents with multi-party consent.',
      creator: {
        '@id': 'https://snaplabs.tech/#organization',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://snaplabs.tech/#tv-show-tracker',
      name: 'TV Show Tracker',
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: 'Web, Mobile',
      description: 'Cross-platform, low-latency release tracker for syndicated television and episodic series.',
      creator: {
        '@id': 'https://snaplabs.tech/#organization',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#09090b]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#09090b" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
    <meta name="color-scheme" content="dark" />

    <!-- Crawlability, Canonical & Sitemap -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SnapLabs" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content="SnapLabs — Purpose Built Software" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="SnapLabs — Purpose Built Software" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Fonts: Cormorant Garamond (Editorial Display), Geist (Interface), Geist Mono (Telemetry) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#09090b] text-[#e4e4e7]">
    <!-- Mobile Native Top Glass Navigation Bar -->
    <HeaderNav client:load />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/[0.06] pt-14 pb-[calc(3.5rem+env(safe-area-inset-bottom,0px))] px-6 mt-32 text-xs text-zinc-500">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <div class="text-sm font-serif text-zinc-300 tracking-wide mb-1">SnapLabs</div>
          <div class="text-zinc-500 text-[11px]">Independent engineering. Purpose built software. © {new Date().getFullYear()}</div>
        </div>

        <div class="flex items-center gap-6 text-zinc-400 text-xs">
          <a href="https://github.com/MugguruMonagallu" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
          <a href="mailto:contact@snaplabs.tech" class="hover:text-white transition-colors">contact@snaplabs.tech</a>
          <div class="flex items-center gap-2 pl-4 border-l border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-zinc-400 text-[11px] font-mono">Systems Live</span>
          </div>
        </div>
      </div>
    </footer>

    <ChatWidget client:load siteKey={turnstileSiteKey} />
  </body>
</html>
