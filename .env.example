# Chatbot API configuration (server-side only — never shipped to the browser,
# except variables prefixed with PUBLIC_).
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ==============================================================================
# Level 1 Decision Guardrail (/v1/systemone API with clef-flash)
# ==============================================================================
# Endpoint for the System One classification decision engine.
#CHAT_DECISION_API_BASE_URL=https://api.experientiallabs.ai/v1/systemone
#CHAT_DECISION_API_KEY=your_decision_api_key_here
#CHAT_DECISION_MODEL=clef-flash

# Fallback LLM guardrail model (used only if CHAT_DECISION_API_KEY is unset)
#CHAT_GUARD_MODEL=claude-haiku-4-5

# ==============================================================================
# Level 2 Grounded Answer Model (SSE progressive streaming)
# ==============================================================================
# Base URL of the LLM provider's API (no trailing slash).
# Anthropic:  https://api.anthropic.com/v1
# OpenAI-compatible (OpenAI, NVIDIA NIM, etc.): https://api.openai.com/v1
#CHAT_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Wire format. Usually auto-detected from CHAT_API_BASE_URL; set explicitly
# if your provider's URL doesn't make it obvious:
#   anthropic -> POST {base}/messages with x-api-key
#   openai    -> POST {base}/chat/completions with Bearer token
#CHAT_API_FORMAT=openai

# Secret API key for the LLM answer provider. Read lazily at request time on the server.
#CHAT_API_KEY=your_chat_api_key_here

# Level 2 answer model (answers strictly from project knowledge base).
#CHAT_ANSWER_MODEL=meta/llama-3.1-70b-instruct

# ==============================================================================
# Cloudflare Turnstile Bot Mitigation Barrier
# ==============================================================================
# Public Turnstile site key rendered in client widget.
# Can be set as PUBLIC_TURNSTILE_SITE_KEY or TURNSTILE_SITE_KEY.
# If unset, client bot verification is automatically bypassed in development.
#TURNSTILE_SITE_KEY=0x4AAAAAAA...
#PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Secret key for server-side validation against challenges.cloudflare.com/turnstile/v0/siteverify.
# If unset, server-side bot verification is automatically bypassed in development.
#TURNSTILE_SECRET_KEY=0x4AAAAAAA...
