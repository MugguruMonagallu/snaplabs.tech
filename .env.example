# Chatbot API configuration (server-side only — never shipped to the browser).
# Copy to `.env` and fill in real values. `.env` is gitignored.

# Base URL of the LLM provider's API (no trailing slash).
# Anthropic:  https://api.anthropic.com/v1
# OpenAI-compatible (OpenAI, NVIDIA NIM, etc.): https://api.openai.com/v1
#CHAT_API_BASE_URL=https://api.anthropic.com/v1

# Wire format. Usually auto-detected from CHAT_API_BASE_URL; set explicitly
# if your provider's URL doesn't make it obvious:
#   anthropic -> POST {base}/messages with x-api-key
#   openai    -> POST {base}/chat/completions with Bearer token
#CHAT_API_FORMAT=anthropic

# Secret API key for the LLM provider. Read lazily at request time on the server.
#CHAT_API_KEY=

# Level 1 — guardrail/filter model (cheap, fast; returns a JSON verdict).
#CHAT_GUARD_MODEL=claude-haiku-4-5

# Level 2 — answer model (answers only from the knowledge-base context).
#CHAT_ANSWER_MODEL=claude-sonnet-4-5
